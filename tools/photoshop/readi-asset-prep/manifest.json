{
  "manifestVersion": 5,
  "id": "com.czkiii.readiworld.assetprep",
  "name": "Readi Asset Prep",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0",
    "data": {
      "apiVersion": 2,
      "loadEvent": "use"
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "readiAssetPrepPanel",
      "label": {
        "default": "Readi Asset Prep"
      },
      "minimumSize": {
        "width": 300,
        "height": 420
      },
      "maximumSize": {
        "width": 720,
        "height": 1200
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 720
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 820
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request"
  }
}
